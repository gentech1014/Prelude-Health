{#-
  Icons are inline SVG, never a font or a linked asset: report rendering
  must not depend on outbound network access at print time, for the same
  reason the typeface is embedded as base64 above. The outlines are
  lucide's, which is the icon set the patient app already draws from, so
  the two surfaces of the product look like one.

  `| safe` is correct here and only here: these are literal path data
  defined in this file, not interpolated report content. Everything the
  patient said still goes through the environment's autoescaping.
-#}
{%- set ICON_PATHS = {
  'user': '<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  'users': '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  'info': '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>',
  'calendar': '<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>',
  'clock': '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
  'phone': '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>',
  'stethoscope': '<path d="M11 2v2"/><path d="M5 2v2"/><path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1"/><path d="M8 15a6 6 0 0 0 12 0v-3"/><circle cx="20" cy="10" r="2"/>',
  'hash': '<path d="M4 9h16"/><path d="M4 15h16"/><path d="M10 3 8 21"/><path d="M16 3l-2 18"/>',
  'file-text': '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/>',
  'activity': '<path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"/>',
  'pill': '<path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z"/><path d="m8.5 8.5 7 7"/>',
  'heart': '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>',
  'paperclip': '<path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"/>',
  'target': '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>',
  'pen-line': '<path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7.5 18.5l-4 1 1-4Z"/>',
  'triangle-alert': '<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/>',
  'list': '<path d="M8 6h13"/><path d="M8 12h13"/><path d="M8 18h13"/><path d="M3 6h.01"/><path d="M3 12h.01"/><path d="M3 18h.01"/>'
} -%}
{%- macro icon(name, size=12) -%}
<svg class="icon" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none"
 stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"
>{{ ICON_PATHS[name] | safe }}</svg>
{%- endmacro -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>Pre-Consultation Report - {{ patient_name }}</title>
<style>
  {{ font_face_css }}

  /* No `margin` here -- Chromium honours whichever margin is declared
     last, and an explicit `@page { margin: 0 }` was silently winning over
     the real margin passed to `page.pdf()` in Python, producing a report
     with no page margin at all. Page margin is set in exactly one place:
     the `margin` option in `_html_to_pdf` (report_pdf.py). */
  @page { size: A4; }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    /* Our own system's typeface (`--font-sans` in the patient app's
       theme.css), embedded above -- not a generic PDF default. */
    font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: #1a1a1a;
    font-size: 12px;
    line-height: 1.45;
  }

  /* ---- Main banner: one for the summary, one for the Q&A record.

     The Q&A banner used to force itself onto a fresh page. That is what
     manufactured the blank pages: the summary ends wherever it ends, so
     a forced break turned every leftover into a page of its own -- one
     report had `Information Gaps` alone on page 2 (it overflowed page 1
     by three pixels) and the Q&A banner alone on page 3. The banner is a
     full-width blue bar; it separates the two halves perfectly well
     without costing a sheet of paper every time. ---- */
  .main-banner {
    background-color: #0d72ba;
    color: #ffffff;
    border-radius: 4px;
    padding: 9px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
    /* A banner is a heading for what follows it, so it must never be the
       last thing on a page -- without this the Q&A banner sat alone at the
       foot of the summary while its first question started the next one. */
    page-break-after: avoid;
  }
  .main-banner-left { display: flex; align-items: center; gap: 10px; }
  .banner-title { font-size: 16px; font-weight: 700; letter-spacing: 0.3px; text-transform: uppercase; }
  .banner-tag { font-size: 11px; font-weight: 700; font-style: italic; opacity: 0.9; white-space: nowrap; }

  /* ---- Section header chip + body ---- */
  /* `page-break-inside: avoid` keeps a section's header with its body,
     which is worth having -- but it means a section that does not fit
     moves whole. With 9px between seven of them the summary cleared an
     A4 page by three pixels, so the last one emigrated. */
  .section { margin-bottom: 7px; page-break-inside: avoid; }
  .sec-hdr {
    display: flex;
    /* Centred, not baseline: an inline SVG has no baseline to sit on, so
       every header icon rode high above its own title. */
    align-items: center;
    gap: 7px;
    padding: 5px 9px;
    border-radius: 3px;
    margin-bottom: 6px;
  }
  .sec-hdr .num {
    width: 17px; height: 17px; border-radius: 3px;
    display: inline-flex; align-items: center; justify-content: center;
    color: #fff; font-size: 10px; font-weight: 700; flex-shrink: 0;
  }
  .sec-hdr-title { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.25px; }
  .sec-hdr-sub { font-weight: 400; text-transform: none; font-size: 9.5px; margin-left: 4px; }
  .sec-hdr-tag { margin-left: auto; font-size: 9.5px; font-weight: 700; text-transform: uppercase; }

  .sh-blue   { background-color: #d0e6f7; color: #0a4773; }
  .sh-blue .num   { background-color: #0d72ba; }
  .sh-teal   { background-color: #bcebe1; color: #044e42; }
  .sh-teal .num   { background-color: #007a68; }
  .sh-green  { background-color: #c0f0d6; color: #085526; }
  .sh-green .num  { background-color: #10853e; }
  .sh-orange { background-color: #ffe1ce; color: #7a3607; }
  .sh-orange .num { background-color: #b84e09; }
  .sh-yellow { background-color: #fce1bc; color: #793c00; }
  .sh-yellow .num { background-color: #b85b00; }
  .sh-slate  { background-color: #cbe2f0; color: #173b53; }
  .sh-slate .num  { background-color: #214e6e; }
  .sh-coral  { background-color: #f7d6d1; color: #7a241c; }
  .sh-coral .num  { background-color: #b8564a; }

  /* ---- Field rows: bold label + read-only value chip, like a filled form
     field.

     A grid with fixed label columns, not flex rows. They used to be flex
     rows sized by their own contents, each carrying its own inline `flex`
     override, so every row's boxes began and ended at a different x and
     the page read as a zigzag rather than as a form. The columns are now
     the same on every row, and only the text inside them differs. ---- */
  .form-grid {
    display: grid;
    /* Wide enough for the longest label at this weight and size, so a
       label never wraps and drags its whole row's boxes taller with it. */
    grid-template-columns: 88px 1fr 88px 1fr;
    gap: 4px 8px;
    align-items: stretch;
    margin-bottom: 4px;
  }
  /* One field per row, for values that need the full width. */
  .form-grid.wide { grid-template-columns: 120px 1fr; }
  .field-label {
    display: flex;
    align-items: center;
    gap: 4px;
    font-weight: 700;
    font-size: 10px;
    color: #111;
    /* Aligned to the top of its box rather than centred, so a label
       beside a value that wrapped to three lines still reads as its
       label rather than floating in the middle of it. */
    padding-top: 4px;
  }
  .value-box {
    background-color: #ebf3f9;
    border: 1px solid #b0cadb;
    border-radius: 2px;
    padding: 3px 7px;
    font-size: 11.5px;
    color: #1a1a1a;
    /* One height for every box, and one width per column. A box grows
       only when its own text genuinely wraps, which is the only reason
       two of them should ever differ. */
    min-height: 20px;
    display: flex;
    align-items: center;
  }
  .value-box.empty { color: #7a7a7a; font-style: italic; }
  /* Who said this, beside what was said -- a patient's own words and an
     automatic guess must never read as the same kind of fact. */
  .value-note { color: #5c6b78; font-style: italic; font-size: 10px; white-space: nowrap; }
  .notes-box {
    background-color: #ebf3f9;
    border: 1px solid #b0cadb;
    border-radius: 2px;
    padding: 7px 9px;
    font-size: 11.5px;
  }

  /* ---- Checklist grid: reported items shown pre-checked ---- */
  .grid-2col { display: grid; grid-template-columns: 1fr 1fr; gap: 3px 18px; }
  .grid-3col { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 3px 16px; }
  .col-heading { font-weight: 700; font-size: 10px; margin-bottom: 4px; }
  .checklist-col { display: flex; flex-direction: column; gap: 3.5px; }
  .chk-item { display: flex; align-items: flex-start; gap: 6px; font-size: 11px; }
  .chk-item .box {
    width: 11px; height: 11px; border-radius: 2px; flex-shrink: 0; margin-top: 2px;
    background-color: #0d72ba; color: #fff; font-size: 8.5px; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
  }

  /* ---- Medication table ---- */
  table.med-table { width: 100%; border-collapse: collapse; font-size: 10.5px; margin-bottom: 8px; }
  table.med-table th {
    background-color: #e0ebf3; color: #111; font-weight: 700;
    padding: 4px 7px; text-align: left; border: 1px solid #b0cadb;
  }
  table.med-table td { border: 1px solid #b0cadb; padding: 4px 7px; }

  /* ---- Flagged callout ---- */
  .flagged {
    border-left: 3px solid #b8564a;
    background: #fbf1f0;
    padding: 7px 11px;
    margin-top: 8px;
    border-radius: 0 3px 3px 0;
  }
  .flagged .heading { color: #b8564a; font-weight: 700; font-size: 9.5px; letter-spacing: 0.25px; text-transform: uppercase; margin-bottom: 4px; }
  .flagged .q { font-style: italic; margin-top: 5px; }
  .flagged .a { color: #4a4a4a; }

  /* ---- Q&A page: fixed-width bold question + answer value box.

     The answer box used to shrink-wrap its own text, so a column of
     answers came out as a staircase of different widths -- the same
     zigzag as the field rows above, and more obvious here because there
     are sixteen of them in a row. ---- */
  .qa-item {
    display: grid;
    grid-template-columns: 235px 1fr;
    gap: 10px;
    align-items: stretch;
    margin-bottom: 6px;
    page-break-inside: avoid;
  }
  .qa-item .q-text { font-weight: 700; font-size: 10.5px; color: #111; padding-top: 4px; }
  .qa-item .flag-badge {
    display: inline-block; margin-left: 6px; padding: 1px 6px; border-radius: 2px;
    background: #b8564a; color: #fff; font-size: 8px; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.25px; vertical-align: middle;
  }

  .disclaimer {
    margin-top: 9px; padding-top: 7px; border-top: 1px solid #e2e6e3;
    color: #6b6b6b; font-style: italic; font-size: 9px;
  }
</style>
</head>
<body>

  <!-- ============ PART 1: SUMMARY REPORT ============ -->
  <div class="main-banner">
    <div class="main-banner-left">
      <span class="banner-title">Pre-Consultation Report</span>
    </div>
    <span class="banner-tag">{{ category_label }}</span>
  </div>

  <!-- 1. Patient demographics -->
  <div class="section">
    <div class="sec-hdr sh-blue"><span class="num">1</span>{{ icon('user', 13) }}<span class="sec-hdr-title">Patient Demographics</span></div>
    {#- The phone cell is always rendered, empty state and all. It used to
        be conditional, which left a dangling half-row whenever a patient
        had no number on file and broke the column alignment for the rest
        of the block. A number nobody has is also worth stating. -#}
    <div class="form-grid">
      <span class="field-label">{{ icon('user') }}Patient name</span>
      <span class="value-box">{{ patient_name }}</span>
      <span class="field-label">{{ icon('info') }}Age / sex</span>
      <span class="value-box">{{ patient_age }} &middot; {{ patient_sex }}</span>

      <span class="field-label">{{ icon('calendar') }}Date of birth</span>
      <span class="value-box">{{ patient_dob }}</span>
      <span class="field-label">{{ icon('phone') }}Phone</span>
      <span class="value-box {{ '' if patient_phone else 'empty' }}">{{ patient_phone or "Not given." }}</span>

      <span class="field-label">{{ icon('stethoscope') }}Physician</span>
      <span class="value-box">{{ physician }}</span>
      <span class="field-label">{{ icon('clock') }}Appointment</span>
      <span class="value-box">{{ appointment }}</span>

      <span class="field-label">{{ icon('hash') }}Session ref</span>
      <span class="value-box">{{ session_id }}</span>
      <span class="field-label">{{ icon('file-text') }}Generated</span>
      <span class="value-box">{{ generated_at }}</span>
    </div>
  </div>

  <!-- 2. Reason for visit / chief complaint -->
  <div class="section">
    <div class="sec-hdr sh-teal"><span class="num">2</span>{{ icon('activity', 13) }}<span class="sec-hdr-title">Reason for Visit / Chief Complaint</span></div>
    <div class="notes-box" style="font-weight:600;margin-bottom:6px;">{{ chief_concern }}</div>
    <div class="notes-box">{{ clinical_summary }}</div>
    {% if flagged %}
    <div class="flagged">
      <div class="heading">Flagged &mdash; in the patient's own words</div>
      {% for f in flagged %}
      <div class="q">&ldquo;{{ f.question }}&rdquo;</div>
      <div class="a">{{ f.answer }}</div>
      {% endfor %}
    </div>
    {% endif %}
  </div>

  <!-- 3. Medications & allergies -->
  <div class="section">
    <div class="sec-hdr sh-orange"><span class="num">3</span>{{ icon('pill', 13) }}<span class="sec-hdr-title">Medications &amp; Allergies</span></div>
    {% if medications %}
    <table class="med-table">
      <tr><th style="width:34%;">Name</th><th style="width:18%;">Dose</th><th style="width:22%;">Frequency</th><th>Reason</th></tr>
      {% for m in medications %}
      <tr><td>{{ m.name }}</td><td>{{ m.dose or "" }}</td><td>{{ m.frequency or "" }}</td><td>{{ m.reason or "" }}</td></tr>
      {% endfor %}
    </table>
    {% else %}
    <div class="value-box empty" style="margin-bottom:8px;">None reported.</div>
    {% endif %}
    <div class="col-heading">Allergies</div>
    {% if allergies %}
    <div class="checklist-col">
      {% for a in allergies %}
      <div class="chk-item"><span class="box">&#10003;</span><span>{{ a.allergen }}{% if a.reaction %} &mdash; {{ a.reaction }}{% endif %}</span></div>
      {% endfor %}
    </div>
    {% else %}
    <div class="value-box empty">No known allergies reported.</div>
    {% endif %}
  </div>

  <!-- 4. Medical & family history -->
  <div class="section">
    <div class="sec-hdr sh-green"><span class="num">4</span>{{ icon('heart', 13) }}<span class="sec-hdr-title">Medical &amp; Family History</span></div>
    <div class="grid-3col">
      <div>
        <div class="col-heading">Ongoing conditions</div>
        {% if ongoing_conditions %}
        <div class="checklist-col">
          {% for c in ongoing_conditions %}<div class="chk-item"><span class="box">&#10003;</span><span>{{ c }}</span></div>{% endfor %}
        </div>
        {% else %}<div class="value-box empty">None reported.</div>{% endif %}
      </div>
      <div>
        <div class="col-heading">Hospital stays</div>
        {% if hospital_stays %}
        <div class="checklist-col">
          {% for h in hospital_stays %}
          <div class="chk-item"><span class="box">&#10003;</span><span>{{ h.reason }}{% if h.timeframe %} ({{ h.timeframe }}){% endif %}</span></div>
          {% endfor %}
        </div>
        {% else %}<div class="value-box empty">None reported.</div>{% endif %}
      </div>
      <div>
        <div class="col-heading">Family history</div>
        {% if family_history %}
        <div class="checklist-col">
          {% for f in family_history %}<div class="chk-item"><span class="box">&#10003;</span><span>{{ f }}</span></div>{% endfor %}
        </div>
        {% else %}<div class="value-box empty">None reported.</div>{% endif %}
      </div>
    </div>
  </div>

  <!-- 5. Lifestyle, social history & recent care -->
  <div class="section">
    <div class="sec-hdr sh-yellow"><span class="num">5</span>{{ icon('users', 13) }}<span class="sec-hdr-title">Lifestyle, Social History &amp; Recent Care</span></div>
    <div class="grid-2col">
      <div>
        <div class="col-heading">Tobacco / alcohol / occupation / living situation</div>
        {% if social_history_lines %}
        <div class="checklist-col">
          {% for line in social_history_lines %}<div class="chk-item"><span class="box">&#10003;</span><span>{{ line }}</span></div>{% endfor %}
        </div>
        {% else %}<div class="value-box empty">Not discussed.</div>{% endif %}
      </div>
      <div>
        <div class="col-heading">Seen elsewhere recently</div>
        {% if recent_care %}
        <div class="checklist-col" style="margin-bottom:6px;">
          {% for r in recent_care %}
          <div class="chk-item"><span class="box">&#10003;</span><span>{{ r.who }}{% if r.when %}, {{ r.when }}{% endif %}{% if r.reason %} &mdash; {{ r.reason }}{% endif %}</span></div>
          {% endfor %}
        </div>
        {% else %}<div class="value-box empty" style="margin-bottom:6px;">None reported.</div>{% endif %}
        <div class="col-heading">Recent tests</div>
        <div class="value-box {{ '' if recent_tests else 'empty' }}">{{ recent_tests or "None reported." }}</div>
      </div>
    </div>
  </div>

  <!-- 6. Patient goals, notes & attachments -->
  <div class="section">
    <div class="sec-hdr sh-blue"><span class="num">6</span>{{ icon('paperclip', 13) }}<span class="sec-hdr-title">Patient Goals, Notes &amp; Attachments</span></div>
    <div class="form-grid wide">
      <span class="field-label">{{ icon('target') }}Goal for visit</span>
      <span class="value-box {{ '' if patient_goal else 'empty' }}">{{ patient_goal or "Not stated." }}</span>
      {% if additional_notes %}
      <span class="field-label">{{ icon('pen-line') }}Also raised</span>
      <span class="value-box">{{ additional_notes }}</span>
      {% endif %}
      <span class="field-label">{{ icon('paperclip') }}Attached document</span>
      {#- What the attachment is, attributed to whoever actually said it.
          The patient's own answer leads: they were asked what the report
          was, and "CBC report" is worth more than the automatic
          description's best possible output, which is bound to modality
          alone and cannot name anything inside the file. -#}
      {% if not document_uploaded %}
      <span class="value-box empty">None uploaded.</span>
      {% elif document_description %}
      <span class="value-box">{{ document_description[0] }}<span class="value-note">
        {%- if document_description[1] %}&nbsp;&mdash; as the patient described it
        {%- else %}&nbsp;&mdash; automatically identified{% endif %}</span></span>
      {% else %}
      <span class="value-box empty">Uploaded; not described.</span>
      {% endif %}
    </div>
    {% if document_download_url %}
    <div style="font-size:10.5px;"><a href="{{ document_download_url }}" style="color:#0d72ba;">View uploaded file &rarr;</a></div>
    {% endif %}
  </div>

  <!-- 7. Information gaps -->
  <div class="section">
    <div class="sec-hdr sh-coral"><span class="num">7</span>{{ icon('triangle-alert', 13) }}<span class="sec-hdr-title">Information Gaps</span></div>
    {% if gaps %}
    <div class="checklist-col">
      {% for g in gaps %}<div class="chk-item"><span class="box" style="background:#b8564a;">!</span><span>{{ g }}</span></div>{% endfor %}
    </div>
    {% else %}
    <div class="value-box empty">None &mdash; every relevant question was answered.</div>
    {% endif %}
  </div>

  {% if findings %}
  <!-- ============ PART 2: DETAILED Q&A (always its own page) ============ -->
  <div class="main-banner qa-banner">
    <div class="main-banner-left">
      <span class="banner-title">Patient Question &amp; Answer Section</span>
    </div>
    <span class="banner-tag">{{ findings|length }} recorded</span>
  </div>

  <div class="section">
    <div class="sec-hdr sh-blue"><span class="num">1</span>{{ icon('list', 13) }}<span class="sec-hdr-title">Full Question-and-Answer Record</span><span class="sec-hdr-sub">this summary was drawn from</span></div>
    {% for f in findings %}
    <div class="qa-item">
      <div class="q-text">Q{{ loop.index }}. {{ f.question }}{% if f.flagged %}<span class="flag-badge">Flagged</span>{% endif %}</div>
      <div class="q-ans"><span class="value-box">{{ f.answer }}</span></div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <div class="disclaimer">{{ disclaimer }}</div>

</body>
</html>
