# --- App ---
APP_ENV=local
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
# When APP_ENV=production, app.core.secrets_loader fetches every secret
# below from AWS Secrets Manager instead of this file -- set
# SECRETS_MANAGER_SECRET_ID to that secret's name/ARN (a single JSON blob
# keyed by these same env-var names). Irrelevant for local/APP_ENV=local.
SECRETS_MANAGER_SECRET_ID=

# --- Mongo ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=prescreening
# Optional. Defaults shown. Raise these only on a link that is slow but
# reliable -- the point of bounding them is that a request nobody can serve
# should fail in seconds rather than hold a patient waiting for thirty.
# MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
# MONGO_CONNECT_TIMEOUT_MS=10000
# MONGO_SOCKET_TIMEOUT_MS=20000

# --- AWS / Bedrock ---
# These are REQUIRED, and they are the only credentials used. boto3's own
# resolution (~/.aws/credentials, the SSO cache, an instance profile) is
# deliberately not consulted -- see src/app/core/aws.py. A developer with an
# expired `aws sso login` would otherwise have the machine's identity silently
# outrank this file, and the failure surfaces as a 403 ExpiredTokenException
# from the middle of a live patient call.
#
# Nova 2 Sonic needs bedrock:InvokeModelWithBidirectionalStream; the summarizer
# needs bedrock:InvokeModel + bedrock:InvokeModelWithResponseStream.
# AWS_REGION must be one of: us-east-1, us-west-2, eu-north-1, ap-northeast-1.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials. A key beginning ASIA (STS/SSO) is rejected
# without it; a permanent IAM key beginning AKIA needs none, and leaving this
# blank for one is correct rather than an omission.
AWS_SESSION_TOKEN=

# --- Live voice model (Nova 2 Sonic, speech-to-speech) ---
# Must be a BARE model id. InvokeModelWithBidirectionalStream rejects an
# application-inference-profile ARN with "The provided model identifier is
# invalid" -- verified live against a profile that was ACTIVE, in the same
# account and region, and mapped to this exact model. Application inference
# profiles do work for SUMMARY_MODEL_ID below, which is a text model.
BIDI_MODEL_ID=amazon.nova-2-sonic-v1:0
BIDI_VOICE=matthew
BIDI_ENDPOINTING_SENSITIVITY=MEDIUM

# --- Summarization model (text, runs after the call) ---
# Unlike BIDI_MODEL_ID, this one does accept an application-inference-profile
# ARN as well as a bare id -- InvokeModel/Converse support them.
SUMMARY_MODEL_ID=global.anthropic.claude-sonnet-4-6
# Only needed if SUMMARY_MODEL_ID's ARN was created in a different region
# than AWS_REGION (e.g. a Haiku profile in ap-south-1 while Nova Sonic
# stays pinned to ap-northeast-1). Falls back to AWS_REGION when blank.
SUMMARY_MODEL_REGION=

# --- Appointment scheduling (slots, cancel/reschedule, sweeper) ---
# Default IANA zone for appointment times. Overridden per doctor by
# Doctor.timezone when set.
CLINIC_TIMEZONE=Asia/Kolkata
SLOT_DURATION_MINUTES=30
# Never offer a reschedule slot starting sooner than this from now.
RESCHEDULE_MIN_LEAD_MINUTES=60
# Max earlier slots the agent may mention in one call.
RESCHEDULE_OFFER_LIMIT=3
# How long a slot stays HELD while a reschedule is in flight before it is
# treated as bookable again.
SLOT_HOLD_TTL_SECONDS=90
# A BOOKED slot whose session is still IN_PROGRESS but hasn't written a
# transcript turn in this long is reclaimed by the sweeper.
ABANDONED_SLOT_RECLAIM_MINUTES=15
# TTL grace period before a past FREE/CANCELLED slot is purged.
SLOT_RETENTION_DAYS=400
# TTL for the scheduling_events audit trail -- deliberately separate from
# SLOT_RETENTION_DAYS: slot storage hygiene and audit history are
# different lifetimes.
SCHEDULING_EVENT_RETENTION_DAYS=365
# How often the lifespan sweeper task ticks.
SWEEP_INTERVAL_SECONDS=60

# --- Booking / scheduling platform integration ---
BOOKING_PLATFORM_BASE_URL=
BOOKING_PLATFORM_API_KEY=
# REQUIRED, min 32 chars. Signs/verifies the inbound booking-confirmed
# webhook (HMAC-SHA256 over the raw body, as the X-Signature header). An
# empty secret still produces a signature that verifies, so anyone could
# fabricate a booking event.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
BOOKING_WEBHOOK_SECRET=

# --- Patient intake link (signed, expiring token) ---
PATIENT_APP_BASE_URL=
# REQUIRED, min 32 chars. An empty secret still produces tokens that verify,
# so patient-call authorization would be forgeable by anyone.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTAKE_LINK_SECRET=
INTAKE_LINK_TTL_SECONDS=172800

# --- Browser session cookie (exchanged from the intake link at attach) ---
# The intake token above is spent once at POST /sessions/{id}/attach and
# traded for this HttpOnly cookie, which authenticates every other patient
# route. SESSION_COOKIE_SECURE must be true anywhere real; it is false by
# default only so local http://localhost development works at all.
# SESSION_COOKIE_SAMESITE: 'lax' is right whenever the patient app and this
# API share a registrable domain -- localhost:5173 -> localhost:8000
# included, since ports do not affect same-site. Use 'none' (which forces
# Secure on) only for genuinely cross-site domains.
SESSION_COOKIE_NAME=prelude_health_session
SESSION_COOKIE_TTL_SECONDS=7200
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
# A browser cannot set headers on a WebSocket handshake, so the socket's
# credential has to sit in the query string. This ticket is minted by an
# authenticated session, spent on first connect, and expires in seconds --
# unlike the intake token, which would open the session for two days.
WS_TICKET_TTL_SECONDS=60

# --- Physician-facing API access ---
# REQUIRED, min 32 chars. Sent as the X-API-Key header to GET
# /sessions/{id}/report -- the one PHI-bearing route in this service.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
PHYSICIAN_API_KEY=

# --- Notifications (SMS/link delivery) ---
# Left unused deliberately: the BA scope says not to build a separate SMS
# integration for the hackathon. NotificationService logs the link instead
# -- see app/services/notification_service.py.
NOTIFICATION_PROVIDER_API_KEY=

# --- Object storage (video + uploaded documents) ---
# Leave STORAGE_ACCESS_KEY/STORAGE_SECRET_KEY/STORAGE_ENDPOINT_URL blank to
# reuse the AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY above (the same AWS
# account already used for Bedrock) -- blank means "same as everything
# else", never "resolve it from the machine". Only fill them in for a
# different account or a non-AWS S3-compatible provider. STORAGE_BUCKET_NAME must be created ahead of time, with
# s3:PutObject/s3:GetObject granted to whichever credentials are in use.
# STORAGE_REGION: set this if the bucket is NOT in AWS_REGION -- S3 has no
# region requirement the way Nova Sonic does, so it often won't be.
# Pre-signed URLs fail outright on a region mismatch (unlike ordinary S3
# calls, which auto-redirect). Leave blank to just use AWS_REGION.
STORAGE_BUCKET_NAME=
STORAGE_REGION=
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Optional. KMS key ID/ARN for SSE-KMS on uploaded objects (the generated
# report PDF). Left blank, uploads still get SSE-S3 (AES256) by default --
# this only matters if you want a customer-managed key specifically.
STORAGE_KMS_KEY_ID=

# --- Browser-facing transport security ---
# Comma-separated browser Origins. Drives two things: which Origins the
# intake WebSocket accepts a handshake from, and the CORS allow-list for
# every REST route. CORS runs with credentials (the session cookie), and a
# wildcard origin is illegal in that combination -- so when this is blank
# the app falls back to Vite's local dev origins rather than to '*'. Set it
# to the patient app's real origin before any non-local deployment.
ALLOWED_ORIGINS=http://localhost:5173

# --- Google Calendar delivery (report + recording links on the doctor's event) ---
# Optional: path to a Google service-account JSON key with Calendar API
# access. Left blank, calendar delivery silently no-ops -- the written
# report remains the primary deliverable either way. The doctor's calendar
# must be shared with this service account's email (Editor access); find
# doctor -> calendar-id mappings in scripts/seed_doctors.py.
GOOGLE_SERVICE_ACCOUNT_FILE=

# --- Doctor self-registration (Google OAuth) ---
# A doctor connects their OWN Google account from the booking UI's settings
# menu and grants calendar read/write, instead of the manual calendar-sharing
# step GOOGLE_SERVICE_ACCOUNT_FILE above needs.
#
# Setup, once per deployment, in Google Cloud Console:
#   1. Enable the Google Calendar API on the project.
#   2. APIs & Services -> Credentials -> Create OAuth client ID -> Web application.
#   3. Add GOOGLE_OAUTH_REDIRECT_URI below verbatim as an authorized redirect URI.
#   4. On the OAuth consent screen, add the Calendar scope
#      (https://www.googleapis.com/auth/calendar) and add each doctor as a
#      test user while the app is unpublished.
# Left blank, POST /api/v1/doctors/registration returns 503 and the booking UI
# shows the feature as unavailable rather than starting a dead-end flow.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/doctors/google/callback
DOCTOR_REGISTRATION_TTL_SECONDS=900

# Origin of the booking UI. The OAuth callback is a browser navigation, so it
# redirects the doctor back to `<BOOKING_APP_BASE_URL>/book` when consent ends.
BOOKING_APP_BASE_URL=http://localhost:5173

# --- Clinic and assistant identity (served to the patient app) ---
# The patient app holds no copy of any of this. It reads all four off the
# session context response, so a rename here reaches every screen without a
# frontend release -- and there is no hardcoded clinic or assistant name in
# the UI that can silently disagree with this deployment.
#
# CLINIC_NAME blank means the patient app names no facility at all (the
# consent copy falls back to "my care team") rather than inventing one.
CLINIC_NAME=
CLINIC_LOCATION=
# The assistant's display name in the UI badge and captions. Not the voice --
# that is BIDI_VOICE above.
ASSISTANT_NAME=Kiara
ASSISTANT_ROLE=Pre-visit assistant

# --- Clinic scheduling window (drives the booking screen's slots) ---
# Slots are generated in CLINIC_TIMEZONE and served with an offset, so a
# clinic's 9am stays 9am whatever timezone the patient's browser is in.
# CLINIC_SLOT_MINUTES is also the appointment length the patient app renders,
# so it never has to assume a duration.
CLINIC_TIMEZONE=Asia/Kolkata
CLINIC_OPEN_HOUR=9
CLINIC_CLOSE_HOUR=17
CLINIC_SLOT_MINUTES=30
# `datetime.weekday()` values the clinic is open on (Monday=0).
CLINIC_OPEN_WEEKDAYS=0,1,2,3,4
BOOKING_HORIZON_DAYS=14
BOOKING_LEAD_TIME_MINUTES=60

# --- Observability ---
LOG_LEVEL=INFO
LOG_JSON=true

# --- Moss (semantic question-bank lookup, additive/isolated -- new DB+index only) ---
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_ENDPOINT=
MOSS_QUESTION_INDEX=prescreening-question-bank
