# Base URL of the backend REST API this UI talks to.
# Must be prefixed with VITE_ to be exposed to client code (Vite convention).
# Note the /api/v1 suffix — the backend mounts REST there.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Origin of the intake WebSocket. Kept separate from the REST base URL on
# purpose: the backend mounts /ws/intake/{id} at the app root, OUTSIDE
# /api/v1, so the socket URL cannot be derived from the REST base by
# string concatenation.
VITE_WS_BASE_URL=ws://localhost:8000
